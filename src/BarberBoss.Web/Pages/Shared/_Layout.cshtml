<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBoss</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            @* <a class="navbar-brand" href="/">BarberBoss</a> *@

            <a class="navbar-brand brand" href="/">
                <img src="~/images/logo.png" asp-append-version="true"
                     class="brand-logo" alt="Logo BarberBoss" />
                <span class="brand-text">BarberBoss</span>
            </a>

            <div class="navbar-nav">
                <a class="nav-link" href="/">Início</a>
                <a class="nav-link" href="/Admin">Admin</a>
                <a class="nav-link" href="/Client">Cliente</a>
                <a class="nav-link" href="/swagger">Swagger</a>


                if (User?.Identity?.IsAuthenticated == true)
                {
                <a class="nav-link text-warning" href="/Account/Logout">Sair</a>
                }
                @*                 else
                {
                    <a class="nav-link text-success" href="/Account/Login">Entrar</a>
                }
 *@
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
