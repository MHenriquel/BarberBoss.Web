<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBoss</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <!-- BRAND (esquerda) -->
            <a class="navbar-brand brand" href="/Admin">
                <img src="~/images/logo.png" class="brand-logo" asp-append-version="true" alt="Logo" />
                <span class="brand-text">BarberBoss</span>
            </a>

            <!-- TOGGLER (mobile) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- NAV + ACTIONS -->
            <div class="collapse navbar-collapse" id="mainNav">

                <!-- MENUS (CENTRO) -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                    <li class="nav-item fw-bold">
                        <a class="nav-link" href="/Admin">Agenda</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold" href="#" role="button" data-bs-toggle="dropdown">Cadastros</a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" href="/Admin/Barbers">Profissionais</a></li>
                            <li><a class="dropdown-item" href="/Admin/Services">Serviços</a></li>
                            <li><a class="dropdown-item" href="/Admin/Customers">Clientes</a></li>
                            <li><a class="dropdown-item" href="/Admin/Branches">Filiais</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold" href="#" role="button" data-bs-toggle="dropdown">Financeiro</a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" href="/Admin/Finance/Cash">Caixa / Faturamento</a></li>
                            <li><a class="dropdown-item" href="/Admin/Finance/Payments">Pagamentos</a></li>
                            <li><hr class="dropdown-divider"></li>

                            <!-- Submenu (2 níveis), se você estiver usando -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item dropdown-toggle fw-bold" href="#">Lançamentos</a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" href="/Admin/Finance/Expenses">Despesas</a></li>
                                    <li><a class="dropdown-item" href="/Admin/Finance/Commissions">Comissões</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold" href="#" role="button" data-bs-toggle="dropdown">Relatórios</a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" href="/Admin/Reports/Schedule">Agenda</a></li>
                            <li><a class="dropdown-item" href="/Admin/Reports/Financial">Financeiro</a></li>
                        </ul>
                    </li>

                </ul>

                <!-- AÇÕES (direita) -->
                <div class="d-flex align-items-center gap-2 ms-lg-auto">
                    @* <a class="btn btn-sm btn-outline-light fw-bold" href="/swagger">API</a> *@

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm auth-btn-exit text-warning" href="/Account/Logout">Sair</a>
                    }

                </div>

            </div>
        </div>
    </nav>
    <div class="container mt-4">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
              document.querySelectorAll(".dropdown-submenu > a").forEach(el => {
                el.addEventListener("click", (e) => {
                  e.preventDefault();
                  e.stopPropagation();

                  const submenu = el.nextElementSibling;
                  if (!submenu) return;

                  const isOpen = submenu.style.display === "block";
                  submenu.style.display = isOpen ? "none" : "block";
                });
              });

              // fecha submenus quando fecha o dropdown principal
              document.querySelectorAll(".dropdown").forEach(dd => {
                dd.addEventListener("hide.bs.dropdown", () => {
                  dd.querySelectorAll(".dropdown-submenu > .dropdown-menu").forEach(sm => sm.style.display = "none");
                });
              });
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
