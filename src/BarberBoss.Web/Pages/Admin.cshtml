</style>

<div class="row g-3">
    <div class="col-12 col-lg-9">
        <div class="calendar-shell">
            <div class="calendar-header sticky">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" id="btnPrev" type="button">◀</button>
                    <button class="btn btn-outline-secondary btn-sm" id="btnToday" type="button">Hoje</button>
                    <button class="btn btn-outline-secondary btn-sm" id="btnNext" type="button">▶</button>
                    <span class="ms-2 pill" id="monthLabel">—</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="legend mb-0">Profissional</label>
                    <select id="barberSelect" class="form-select form-select-sm" style="min-width: 260px;">
                        <option value="">Carregando...</option>
                    </select>
                </div>
            </div>

            <div class="calendar-grid" id="dowRow">
                <div class="dow">Dom</div>
                <div class="dow">Seg</div>
                <div class="dow">Ter</div>
                <div class="dow">Qua</div>
                <div class="dow">Qui</div>
                <div class="dow">Sex</div>
                <div class="dow">Sáb</div>
            </div>

            <div class="calendar-grid" id="calendarGrid">
                <!-- JS gera as células -->
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3">
       @*  <div class="side-panel">
            <div class="side-title">Horários disponíveis</div>
            <div class="legend mb-2" id="selectedInfo">Selecione um dia no calendário…</div>
            <div id="slotsContainer" class="d-grid gap-2"></div>
        </div> *@
        <div class="side-panel sticky">
            <div class="side-title">Horários disponíveis</div>
            <div class="side-subtitle" id="selectedInfo">Selecione um dia no calendário…</div>
            <div id="slotsContainer" class="d-grid gap-2"></div>
        </div>

    </div>
</div>

<!-- Modal (estilo Outlook) para mostrar slots -->
<div class="modal fade" id="slotsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="slotsModalTitle">Horários</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="slotsModalBody" class="d-grid gap-2"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // IDs vindos do backend (para demo pode passar via querystring /Admin?companyId=...&branchId=...)
        const COMPANY_ID = "@Model.CompanyId";
        const BRANCH_ID = "@Model.BranchId";

        const monthLabel = document.getElementById('monthLabel');
        const grid = document.getElementById('calendarGrid');
        const barberSelect = document.getElementById('barberSelect');
        const selectedInfo = document.getElementById('selectedInfo');
        const slotsContainer = document.getElementById('slotsContainer');

        const modalEl = document.getElementById('slotsModal');
        const modal = new bootstrap.Modal(modalEl);
        const modalTitle = document.getElementById('slotsModalTitle');
        const modalBody = document.getElementById('slotsModalBody');

        let cursor = new Date(); // mês atual
        cursor.setDate(1);

        function fmtMonthYear(d) {
            return d.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })
                .replace(/(^\\w)/, m => m.toUpperCase());
        }

        function toYmd(d) {
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth()+1).padStart(2,'0');
            const dd = String(d.getDate()).padStart(2,'0');
            return `${yyyy}-${mm}-${dd}`;
        }

        function clearSelection() {
            document.querySelectorAll('.day-cell').forEach(c => c.classList.remove('selected'));
        }

        function renderCalendar() {
            grid.innerHTML = '';
            monthLabel.textContent = fmtMonthYear(cursor);

            const firstDay = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
            const startWeekday = firstDay.getDay(); // 0=Dom..6=Sáb

            // total days in month
            const lastDay = new Date(cursor.getFullYear(), cursor.getMonth()+1, 0);
            const daysInMonth = lastDay.getDate();

            // Preenche “dias vazios” antes do 1º
            for (let i=0; i<startWeekday; i++) {
                const cell = document.createElement('div');
                cell.className = 'day-cell muted';
                cell.innerHTML = `<div class="day-number muted"> </div>`;
                grid.appendChild(cell);
            }

            const today = new Date();
            for (let day=1; day<=daysInMonth; day++) {
                const date = new Date(cursor.getFullYear(), cursor.getMonth(), day);
                const cell = document.createElement('div');
                cell.className = 'day-cell hoverable';
                cell.dataset.date = toYmd(date);
                cell.innerHTML = `<div class="day-number">${day}</div>`;

                // hoje
                if (date.toDateString() === today.toDateString()) cell.classList.add('today');

                cell.addEventListener('click', async () => {
                    clearSelection();
                    cell.classList.add('selected');
                    await loadAvailability(cell.dataset.date);
                });

                grid.appendChild(cell);
            }

            // Completa o grid até fechar a semana (opcional)
            const totalCells = startWeekday + daysInMonth;
            const remainder = totalCells % 7;
            const fill = remainder === 0 ? 0 : (7 - remainder);
            for (let i=0; i<fill; i++) {
                const cell = document.createElement('div');
                cell.className = 'day-cell muted';
                cell.innerHTML = `<div class="day-number muted"> </div>`;
                grid.appendChild(cell);
            }
        }

        async function loadBarbers() {
            // Se não tiver Company/Branch na querystring, a API vai falhar.
            // Recomendo definir isso por login/tenant. Por enquanto, via querystring.
            // // if (!COMPANY_ID || COMPANY_ID === "00000000-0000-0000-0000-000000000000" ||
            // //     !BRANCH_ID || BRANCH_ID === "00000000-0000-0000-0000-000000000000") {
            // //     barberSelect.innerHTML = `<option value="">Defina companyId e branchId na URL (/Admin?companyId=...&branchId=...)</option>`;
            // //     barberSelect.disabled = true;
            // //     return;
            // // }

            // const url = `/api/barbers?companyId=${COMPANY_ID}&branchId=${BRANCH_ID}`;
            const url = `/api/barbers?companyId=${'9eaabccd-7ce2-4abd-b6c2-e84c77e21a9b'}&branchId=${'2872f5c5-b35e-44b5-9b7e-7bf8eaea710c'}`;
            const res = await fetch(url);
            const data = await res.json();

            barberSelect.innerHTML = `<option value="">Selecione...</option>` +
                data.map(b => `<option value="${b.id}">${b.fullName}</option>`).join('');

            barberSelect.disabled = false;
        }

        async function loadAvailability(ymd) {
            const barberId = barberSelect.value;
            if (!barberId) {
                selectedInfo.textContent = `Selecione um profissional antes de ver horários (${ymd}).`;
                slotsContainer.innerHTML = '';
                return;
            }

            selectedInfo.textContent = `Carregando horários: ${ymd}...`;
            slotsContainer.innerHTML = '';

            const url = `/api/availability?companyId=${'9eaabccd-7ce2-4abd-b6c2-e84c77e21a9b'}&branchId=${'2872f5c5-b35e-44b5-9b7e-7bf8eaea710c'}&barberId=${'ce63a23f-33c9-44c5-b35b-3cc87270f6d7'}&date=${ymd}`;
            const res = await fetch(url);
            if (!res.ok) {
                selectedInfo.textContent = `Erro ao carregar horários (${ymd}).`;
                return;
            }
            debugger;
            const payload = await res.json();
            const slots = payload.slots || [];

            const barberName = barberSelect.options[barberSelect.selectedIndex]?.text ?? '';
            selectedInfo.textContent = `${ymd} — ${barberName}`;


            console.log("payload", payload);
            console.log("slots[0]", payload.slots?.[0]);


            // Preenche o painel lateral
            if (slots.length === 0) {
                // slotsContainer.innerHTML = `<div class="text-muted">Sem horários disponíveis.</div>`;
                slotsContainer.innerHTML = `<div class="side-empty">Sem horários disponíveis.</div>`;
            } else {
                // slotsContainer.innerHTML = slots.map(s => `
                //     <button class="btn btn-outline-primary btn-sm slot-btn" type="button" onclick="openSlotsModal('${ymd}', '${barberName}', '${s.time}')">
                //         ${s.time}
                //     </button>
                // `).join('');

                slotsContainer.innerHTML = slots.map(s => {
                      const time = (typeof s === "string")
                        ? s
                        : (s.time ?? s.Time); // suporta camelCase e PascalCase

                      return `
                        <button class="slot-btn"
                                type="button"
                                onclick="openSlotsModal('${ymd}', '${barberName}', '${time}')">
                            ${time}
                        </button>
                      `;
                  }).join('');

            }
        }

        // Abre modal e lista os slots (pode evoluir para iniciar o agendamento)
        window.openSlotsModal = (ymd, barberName, selectedTime) => {
            modalTitle.textContent = `Horários — ${ymd} (${barberName})`;

            // Aqui mostramos apenas o horário clicado como “selecionado”.
            // Você pode melhorar para listar todos e permitir escolher.
            modalBody.innerHTML = `
                <div class="alert alert-info">
                    <strong>Horário selecionado :</strong> ${selectedTime}<br/>
                    <small>Próximo passo: abrir fluxo de agendamento (serviço, cliente, pagamento Pix/Cartão).</small>
                </div>
                <button class="btn btn-primary" type="button" onclick="alert('Aqui você chama /api/appointments com o horário e serviços selecionados.')">
                    Prosseguir para agendar
                </button>
            `;
            modal.show();
        };

        document.getElementById('btnPrev').addEventListener('click', () => {
            cursor = new Date(cursor.getFullYear(), cursor.getMonth()-1, 1);
            renderCalendar();
        });

        document.getElementById('btnNext').addEventListener('click', () => {
            cursor = new Date(cursor.getFullYear(), cursor.getMonth()+1, 1);
            renderCalendar();
        });

        document.getElementById('btnToday').addEventListener('click', () => {
            const now = new Date();
            cursor = new Date(now.getFullYear(), now.getMonth(), 1);
            renderCalendar();
        });

        barberSelect.addEventListener('change', () => {
            // ao trocar profissional, limpa slots e seleção
            selectedInfo.textContent = `Selecione um dia no calendário…`;
            slotsContainer.innerHTML = '';
            clearSelection();
        });

        // init
        renderCalendar();
        loadBarbers();
    </script>
}