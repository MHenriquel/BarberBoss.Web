    .calendar-header .form-select {
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.20);
        background: rgba(255,255,255,0.08);
        color: #ffffff;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(0,0,0,0.18);
        /* ✅ Faz o navegador desenhar o dropdown (lista) em tema escuro */
        color-scheme: dark;
    }

        /* Fallback p/ navegadores que aceitam estilizar options */
        .calendar-header .form-select option {
            color: #e5e7eb; /* texto claro */
            background: #0b1220; /* fundo escuro */
        }

        /* Quando estiver focado */
        .calendar-header .form-select:focus {
            border-color: rgba(99,102,241,0.65);
            box-shadow: 0 0 0 0.22rem rgba(99, 102, 241, 0.28), 0 8px 18px rgba(0,0,0,0.18);
        }


    /* ===== ESSENCIAL: GRID do calendário ===== */
    .calendar-grid {
        display: grid !important;
        grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
        gap: 0;
    }

    /* Dias da semana */
    .dow {
        background: #f1f5f9;
        padding: 10px 12px;
        font-weight: 900;
        font-size: 12px;
        color: #0f172a;
        border-bottom: 1px solid #e2e8f0;
    }

    /* Células dos dias */
    .day-cell {
        min-height: 110px;
        padding: 10px 10px 12px;
        border-right: 1px solid #eef2f7;
        border-bottom: 1px solid #eef2f7;
        cursor: pointer;
        position: relative;
    }

        .day-cell:nth-child(7n) {
            border-right: none;
        }

    .day-number {
        font-weight: 900;
        font-size: 12px;
        color: #0f172a;
    }

    .muted {
        color: #94a3b8;
    }

    .today {
        outline: 2px solid #2563eb;
        outline-offset: -2px;
        border-radius: 8px;
    }

    .selected {
        background: #eff6ff;
    }

    .hoverable:hover {
        background: #f8fafc;
    }

    /* ===== PAINEL “HORÁRIOS DISPONÍVEIS” (destacado e estiloso) ===== */
    .side-panel {
        border-radius: 14px;
        border: 1px solid rgba(99, 102, 241, 0.22);
        /* Fundo diferente do calendário (gradiente elegante) */
        background: radial-gradient(900px circle at 20% 0%, rgba(99, 102, 241, 0.22), transparent 48%), radial-gradient(700px circle at 90% 30%, rgba(59, 130, 246, 0.16), transparent 52%), linear-gradient(180deg, #0b1220, #0f172a);
        color: #fff;
        padding: 14px;
        box-shadow: 0 18px 38px rgba(15, 23, 42, 0.25), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }
    .side-title {
        font-size: 14px;
        font-weight: 900;
        margin-bottom: 6px;
        letter-spacing: 0.2px;
    }

    .side-subtitle {
        font-size: 12px;
        color: rgba(255,255,255,0.75);
        margin-bottom: 12px;
    }

    /* área da lista de horários */
    #slotsContainer {
        margin-top: 10px;
    }

    /* Botões de horários (bonitos e legíveis no painel escuro) */
    .slot-btn {
        width: 100%;
        text-align: left;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.06);
        color: #e5e7eb;
        padding: 10px 12px;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(0,0,0,0.18);
        transition: transform .12s ease, background .12s ease, border-color .12s ease;
    }

        .slot-btn:hover {
            background: rgba(255,255,255,0.10);
            border-color: rgba(99,102,241,0.38);
            transform: translateY(-1px);
            color: #fff;
        }

    /* “chip” de horário dentro do botão (opcional) */
    .slot-time {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .slot-time::before {
            content: "⏱️";
            opacity: .9;
        }

    /* Mensagem “sem horários” coerente com painel escuro */
    .side-empty {
        padding: 12px;
        border-radius: 12px;
        border: 1px dashed rgba(255,255,255,0.18);
        color: rgba(255,255,255,0.75);
        background: rgba(255,255,255,0.04);
