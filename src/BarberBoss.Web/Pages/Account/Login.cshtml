@page
@model BarberBoss.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutAuth";
}

<div class="auth-bg">
    <div class="auth-backdrop">
        <div class="auth-card">

            <div class="auth-header">
                <div class="auth-badge mb-3">
                    <span>✂️</span>
                    <span>BarberBoss</span>
                </div>

                <h3 class="auth-title">Bem-vindo</h3>
                <p class="auth-subtitle">Entre para acessar sua agenda e financeiro.</p>
            </div>

            <div class="auth-body">

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input class="form-control" asp-for="Input.UserName"
                               autocomplete="username" placeholder="ex.: admin" />
                        <span class="text-danger" asp-validation-for="Input.UserName"></span>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Senha</label>
                        <input class="form-control" asp-for="Input.Password"
                               type="password" autocomplete="current-password"
                               placeholder="••••••••" />
                        <span class="text-danger" asp-validation-for="Input.Password"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label text-white-50">Manter conectado</label>
                        </div>

                        <a class="text-white-50 text-decoration-none" href="#" onclick="alert('Em breve!')">Esqueci a senha</a>
                    </div>

                    @* <button class="btn btn-primary w-100 auth-btn" type="submit">Entrar</button> *@

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary w-100 auth-btn" type="submit">
                            Entrar
                        </button>

                        <button class="btn w-100 auth-btn-exit" type="button" onclick="exitApp()">
                            Sair
                        </button>

                    </div>
                </form>

            </div>

            @* <div class="auth-footer">
                <span>Dica DEV: <strong>admin / Admin@123</strong> (se seed estiver ativo).</span>
            </div> *@

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function exitApp() {
          // 1) tenta fechar a janela/aba (funciona se foi aberta por script)
          try {
            window.open('', '_self'); // alguns browsers exigem
            window.close();
          } catch (e) { }

          // 2) fallback: se não fechar, troca o conteúdo por uma página em branco
          // e orienta o usuário a fechar a aba/janela.
          setTimeout(() => {
            // se ainda estamos aqui, o close foi bloqueado
            document.body.innerHTML = `
              <div style="min-height:100vh;display:grid;place-items:center;background:#0b1220;color:#fff;font-family:system-ui;padding:24px;text-align:center">
                <div>
                  <h2 style="margin:0 0 10px 0;">Você saiu com segurança ✅</h2>
                  <p style="opacity:.85;margin:0 0 16px 0;">
                    Por segurança, o navegador pode impedir que a página feche a aba automaticamente.<br/>
                    Você pode fechar esta aba/janela agora.
                  </p>
                  <button onclick="window.location.href='about:blank'"
                          style="padding:10px 14px;border-radius:12px;border:0;background:#3b82f6;color:#fff;font-weight:700;cursor:pointer">
                    Ir para página em branco
                  </button>
                </div>
              </div>`;
          }, 150);
        }
    </script>
}

